# ============================================================================
# CCTV BUSINESS ECOSYSTEM - DJANGO REST API ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in production credentials for Render / Neon
# ============================================================================

# Django Core
SECRET_KEY=replace-with-a-strong-random-50-char-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Central Website Database (Neon PostgreSQL)
# Format: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
# If omitted locally, falls back to local db.sqlite3 for offline development testing
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-darkness-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Desktop Application Synchronization Secret Key
# Must match api.key in DEVELOPMENT/LOGINN/db.properties
DESKTOP_SYNC_API_KEY=LOGISZ-DESKTOP-SYNC-SECRET-KEY-2026

# CORS Allowed Origins (Vercel frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-cctv-store.vercel.app

# Cloudinary External Image Hosting (for Product Galleries & Banners)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Business Contact (WhatsApp & Store Info)
BUSINESS_WHATSAPP=+213550000000
BUSINESS_NAME=LOGISZ SECURITY & CCTV SYSTEMS
RESERVATION_EXPIRY_HOURS=48

